# Server-only Supabase PostgreSQL connection, including required TLS options.
DATABASE_URL=
# Public project URL and publishable client key. The anon key is also supported.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server-only admin key; required for account deletion, never for normal sync.
SUPABASE_SERVICE_ROLE_KEY=

# Optional canonical URL for sitemap generation after deployment.
NEXT_PUBLIC_SITE_URL=

# Leave unset on public deployments. Set to 1 only for an embedded sandbox preview.
ALLOW_PREVIEW_EMBEDDING=
