# Server-only Supabase PostgreSQL connection, including required TLS options.
DATABASE_URL=
# Public project URL and publishable client key. The anon key is also supported.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server-only admin key; required for account deletion, never for normal sync.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical URL for sitemap and trusted speech origin behind an HTTPS proxy.
# Set to the exact public origin when enabling enhanced audio.
NEXT_PUBLIC_SITE_URL=

# Leave unset on public deployments. Set to 1 only for an embedded sandbox preview.
ALLOW_PREVIEW_EMBEDDING=

# Optional enhanced British audio (server-only). Use Azure Speech F0 for free quotas.
# Without these, the website uses device speech and clearly shows unavailable enhancement.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
