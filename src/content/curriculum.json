      "unlockAccuracyPercent": 0,
      "requiredSessions": 0
    },
    {
      "id": 2,
      "name": "Silent \"e\" and Long Vowels",
      "description": "Hear how a final silent e changes a vowel sound."
    },
    {
      "id": 3,
      "name": "Double Consonants",
      "description": "Practise words with two matching consonants together."
    },
    {
      "id": 4,
      "name": "Common Digraphs (sh, ch, th, wh, ph)",
      "description": "Learn common pairs of letters and their sounds."
    },
    {
      "id": 5,
      "name": "Blends (bl, br, cl, cr, dr, fl, fr, tr)",
      "description": "Listen for consonants that blend at the start of a word."
    },
    {
      "id": 6,
      "name": "Syllable Patterns (2 syllables, stress)",
      "description": "Break useful words into two spoken parts."
    },
    {
      "id": 7,
      "name": "Complex Patterns (silent letters, irregulars)",
      "description": "Practise silent letters and less predictable spellings."
    },
    {
      "id": 8,
      "name": "Dictation & Phrases",
      "description": "Listen and spell useful phrases for everyday situations.",
      "unlockAccuracyPercent": 75
    }
  ],
  "patterns": [
    {
      "category": "short_cvc",
      "description": "A consonant, a short vowel and a final consonant.",
      "orderIndex": 0,
      "exampleWords": [
        "cat",
        "dog",
        "sun"
      ]
    },
    {
      "category": "silent_e",
      "description": "A final e is silent and often changes the earlier vowel sound.",
      "orderIndex": 1,
      "exampleWords": [
        "name",
        "time",
        "ride"
      ]
    },
    {
      "category": "double_consonant",
      "description": "Notice two matching consonant letters in the spelling.",
      "orderIndex": 2,
      "exampleWords": [
        "letter",
        "happy",
        "dinner"
      ]
    },
    {
      "category": "digraph_sh",
      "description": "The letters sh usually represent /ʃ/.",
      "orderIndex": 3,
      "exampleWords": [
        "ship"
      ]
    },
    {
      "category": "digraph_ch",
      "description": "The letters ch often represent /tʃ/.",
      "orderIndex": 4,
      "exampleWords": [
        "chair"
      ]
    },
    {
      "category": "digraph_th",
      "description": "The letters th can represent /θ/ or /ð/.",
      "orderIndex": 5,
      "exampleWords": [
        "think"
      ]
    },
    {
      "category": "digraph_wh",
      "description": "In Standard Southern British English, wh usually represents /w/.",
      "orderIndex": 6,
      "exampleWords": [
        "when"
      ]
    },
    {
      "category": "digraph_ph",
      "description": "The letters ph commonly represent /f/.",
      "orderIndex": 7,
      "exampleWords": [
        "phone"
      ]
    },
    {
      "category": "blend_bl",
      "description": "Hear /b/ followed by /l/ at the start.",
      "orderIndex": 8,
      "exampleWords": [
        "black"
      ]
    },
    {
      "category": "blend_br",
      "description": "Hear /b/ followed by /r/ at the start.",
      "orderIndex": 9,
      "exampleWords": [
        "bring"
      ]
    },
    {
      "category": "blend_cl",
      "description": "Hear /k/ followed by /l/ at the start.",
      "orderIndex": 10,
      "exampleWords": [
        "cloud"
      ]
    },
    {
      "category": "blend_tr",
      "description": "Hear the tr consonant blend at the start.",
      "orderIndex": 11,
      "exampleWords": [
        "train"
      ]
    },
    {
      "category": "blend_fl",
      "description": "Hear /f/ followed by /l/ at the start.",
      "orderIndex": 12,
      "exampleWords": [
        "floor"
      ]
    },
    {
      "category": "blend_fr",
      "description": "Hear /f/ followed by /r/, as in free, fresh and from.",
      "orderIndex": 13,
      "exampleWords": [
        "free",
        "fresh",
        "from"
      ]
    },
    {
      "category": "two_syllables",
      "description": "Hear two syllables and notice which is stressed.",
      "orderIndex": 14,
      "exampleWords": [
        "table",
        "garden",
        "mother"
      ]
    },
    {
      "category": "silent_letter",
      "description": "Some written letters have no separate spoken sound.",
      "orderIndex": 15,
      "exampleWords": [
        "knife",
        "write",
        "answer"
      ]
    },
    {
      "category": "irregular",
      "description": "Some common words need extra practice because their spelling is less predictable.",
      "orderIndex": 16,
      "exampleWords": [
        "business"
      ]
    },
    {
      "category": "dictation",
      "description": "Listen to a useful phrase, including the spaces between words.",
      "orderIndex": 17,
      "exampleWords": [
        "thank you very much",
        "how are you today",
        "a return ticket please"
      ]
    }
  ],
